# Copy this file to .env.local and fill in your own values.
# .env.local is in .gitignore, so it will never be committed.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Stage 2 — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: change the AI models without changing code (defaults: gemini-3.5-flash-lite, then gemini-3.1-flash-lite)
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Stage 4 — Firebase web app settings (Firebase console → Project settings → Your apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional: the address used in share links and QR codes. Leave empty — on Vercel the
# website's own address is used, and "npm run dev:phone" fills in your Wi-Fi address.
# PUBLIC_URL=
